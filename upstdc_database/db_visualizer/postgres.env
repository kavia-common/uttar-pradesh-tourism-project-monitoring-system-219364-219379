# This file is generated by upstdc_database/startup.sh and reflects the active host/port.
# Default port is 5000 unless PGPORT is provided. You may source this to configure the viewer.
export POSTGRES_URL="postgresql://localhost:5000/myapp"
export POSTGRES_USER="appuser"
export POSTGRES_PASSWORD="dbuser123"
export POSTGRES_DB="myapp"
export POSTGRES_PORT="5000"
